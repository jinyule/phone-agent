<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Started by AndroidScreenDeviceTest from the app process (another uid), so they are exported. -->
        <activity
            android:name="dev.phoneagent.app.adapters.screen.SecureActivity"
            android:exported="true" />
        <activity
            android:name="dev.phoneagent.app.adapters.screen.FieldActivity"
            android:exported="true" />
        <!-- singleTop: a second intent reaches the open page (onNewIntent) instead of opening another.
             No action bar: drawn edge to edge, it would lie over the counts at the top of the page. -->
        <activity
            android:name="dev.phoneagent.app.adapters.screen.PressActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
