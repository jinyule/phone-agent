<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only helper self-check, run with `am broadcast -n dev.phoneagent/dev.phoneagent.app.debug.HelperSelfCheckReceiver`.
             The shell cannot reach unexported receivers, so it is exported to DUMP holders only. -->
        <receiver
            android:name=".debug.HelperSelfCheckReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Debug-only model configuration from a computer (`adb shell content write/read`, see
             DebugModelConfigProvider). Exported because the shell cannot open unexported providers;
             DUMP keeps apps out and the provider also checks uid 2000. Release builds have no such entry. -->
        <provider
            android:name=".debug.DebugModelConfigProvider"
            android:authorities="${applicationId}.debug.model"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
