<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Not held at install time: the shell-uid helper grants it during onboarding (grantSelf,
         phase1-architecture D4), and only then can the app write enabled_accessibility_services
         and adb_wifi_enabled itself. A permission the manifest does not request cannot be
         granted at all, so it is declared here even though it stays ungranted until setup. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- phone_intent alarm / timer (AlarmClock.ACTION_SET_ALARM, ACTION_SET_TIMER). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!--
      Package visibility: phone_apps lists every app of the user and AndroidScreen names the
      foreground package and activity, including picker and permission screens of system
      packages. <queries> would hide apps without a launcher entry and the activities of packages
      that no declared intent matches. PhoneAgent is sideloaded, so Play's restriction on this
      permission does not apply.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Model providers ("test and save", and tasks from B on). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Session logs, screenshots and credentials never leave the device (phase1-architecture §3.9). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The shell-uid helper hands its Binder over here (phase1-architecture §2.2). Exported for
             the shell; INTERACT_ACROSS_USERS_FULL keeps ordinary apps out, and HelperClient still
             checks uid 2000, the nonce, identity() and the protocol/APK of every offer. -->
        <provider
            android:name=".helper.HelperHandoffProvider"
            android:authorities="${applicationId}.helper"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name=".service.AgentAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_accessibility_service" />
        </service>
    </application>
</manifest>
